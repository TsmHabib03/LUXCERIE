  "narrative": {
    "northStar": "The Display Vitrine",
    "overview": "Luxcerie's white and off-white glass surfaces frame real bag photography, with restrained blush warmth and metallic gold for identity and action. High-contrast serif lettering carries the identity; quieter sans-serif controls guide browsing and inquiries. Straight borders and square containers establish a precise, restrained retail presence.",
    "keyCharacteristics": [
      "Real transparent product photographs remain the focal content.",
      "Gold marks identity, selected states and primary actions.",
      "Every UI corner is square.",
      "Typography separates expressive identity from practical controls."
    ],
    "rules": [
      {
        "name": "The Gold Signal Rule",
        "body": "Gold communicates identity and action; pink stays in surfaces, while product photographs provide the collection's stronger color variation.",
        "section": "colors"
      },
      {
        "name": "The Role Separation Rule",
        "body": "Serif type carries identity and product titles; sans-serif type carries facts, descriptions and actions.",
        "section": "typography"
      },
      {
        "name": "The Square Rule",
        "body": "All UI borders, cards, controls, fields, dividers and navigation have rigid 90-degree corners, with zero radius.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** keep real product photographs dominant and preserve transparent contours.",
      "**Do** use gold to identify actions and selected states.",
      "**Do** retain visible focus, reduced-motion support and mobile safe-area spacing.",
      "**Do** ask for product price and availability through the inquiry flow when those facts are unavailable."
    ],
    "donts": [
      "**Don't** introduce curved corners into UI components.",
      "**Don't** replace bag photography with decorative illustration.",
      "**Don't** invent prices, availability, certification records or perfume inventory.",
      "**Don't** use the decorative wordmark tracking as a style for long body copy."
    ]
  }
}
